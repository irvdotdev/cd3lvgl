{
  "name": "cd3lvgl-figma-plugin",
  "version": "1.0.0",
  "description": "Figma plugin to export frames as cd3lvgl editor JSON",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2020 --platform=neutral && cp src/ui.html dist/ui.html",
    "watch": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2020 --platform=neutral --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
